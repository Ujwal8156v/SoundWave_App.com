NODE_ENV=development
PORT=5000
HOST=localhost

DATABASE_URL=postgresql://postgres:password@localhost:5432/soundwave
DATABASE_TEST_URL=postgresql://postgres:password@localhost:5432/soundwave_test
DB_SSL=disable
DB_POOL_MIN=5
DB_POOL_MAX=20

REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_TTL=86400

JWT_SECRET=your_super_secret_key_min_32_characters_long_here_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_characters_long_here
JWT_REFRESH_EXPIRE=30d

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/v1/auth/spotify/callback

YOUTUBE_API_KEY=

LAST_FM_API_KEY=
LAST_FM_API_SECRET=

GENIUS_API_KEY=

SOUNDCLOUD_CLIENT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=soundwave-music
AWS_REGION=us-east-1
MAX_FILE_SIZE=52428800

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@soundwave.com
EMAIL_FROM_NAME=SoundWave

LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_CONSOLE=true

BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=http://localhost:8000

RABBITMQ_URL=amqp://guest:guest@localhost:5672
