# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MOBILE_APP_ID=com.soundwave.music

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/soundwave
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/soundwave_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Third-party APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=AIzaSyBS-jmRDJCZ20X47qQc29VCtUhqZtXo0UU
LAST_FM_API_KEY=
GENIUS_API_KEY=
SOUNDCLOUD_CLIENT_ID=

# File Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=soundwave-music
AWS_REGION=us-east-1

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m
